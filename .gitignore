# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data — regenerated by `python scripts/fetch_data.py`. Using data/processed/*
# (not data/processed/) so git still descends into the folder and the
# negations below can re-include specific small files.
data/raw/
data/processed/*

# Large intermediate caches are regenerated by scripts/*.py and gitignored;
# the small derived parquets under results/ (used by the dashboard) are
# committed intentionally so the app works without a full pipeline rerun.
*.parquet
!results/**/*.parquet

# close.parquet + benchmark.parquet (~2.3MB total) are the only two files
# app/streamlit_app.py reads — committed so the deployed app works without a
# live yfinance fetch on every cold start (slow, and rate-limit-prone on a
# shared free-tier host). Everything else in data/processed/ stays ignored.
!data/processed/close.parquet
!data/processed/benchmark.parquet

# Results figures/tables are committed selectively; ignore scratch
results/**/*.tmp
.cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
